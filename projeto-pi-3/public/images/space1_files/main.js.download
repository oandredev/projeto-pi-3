          class="hide-icon"\r
          style="display: none"\r
        />\r
      </button>\r
    </div>\r
\r
    <button id="buttonSubmit" type="submit" disabled>ENTRAR</button>\r
  </form>\r
\r
  <p id="loginRedirect">J\xE1 tem uma conta? <a routerLink="/login">Conectar</a></p>\r
</section>\r
