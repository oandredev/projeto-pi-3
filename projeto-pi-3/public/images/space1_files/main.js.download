    />\r
\r
    <!-- SENHA -->\r
    <label for="password">Senha <span style="color: red">*</span></label>\r
    <small id="errorPassword" class="inputError"></small>\r
\r
    <div class="togglePasswordContainer" id="togglePasswordContainer1">\r
      <input\r
        type="password"\r
        name="password"\r
        id="password"\r
        maxlength="50"\r
        required\r
        [(ngModel)]="passwordField"\r
        (blur)="UpdateFirstInput('password')"\r
        (input)="PasswordIsValid(passwordField); PasswordsAreValid(); checkForm()"\r
      />\r
\r
      <button\r
        type="button"\r
        class="togglePasswordVisibility"\r
        (click)="TogglePasswordVisibility('1')"\r
        (mouseleave)="TogglePasswordVisibility('1', true)"\r
      >\r
        <img src="../icons/icon_show.png" id="show-icon-1" class="show-icon" />\r
        <img\r
          src="../icons/icon_hide.png"\r
          id="hide-icon-1"\r
          class="hide-icon"\r
          style="display: none"\r
        />\r
      </button>\r
    </div>\r
\r
    <!-- CONFIRMAR SENHA -->\r
    <label for="passwordConfirmation">Confirma\xE7\xE3o da Senha <span style="color: red">*</span></label>\r
    <small id="errorPasswordC" class="inputError"></small>\r
\r
    <div class="togglePasswordContainer" id="togglePasswordContainer2">\r
      <input\r
        type="password"\r
        name="passwordConfirmation"\r
        id="passwordConfirmation"\r
        maxlength="50"\r
        required\r
