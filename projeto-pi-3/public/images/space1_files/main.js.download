  <div id="sectionTitle">\r
    <h1>Cadastre-se</h1>\r
    <hr />\r
  </div>\r
\r
  <p>Crie sua conta agora mesmo. R\xE1pido e pr\xE1tico</p>\r
\r
  <form #form="ngForm" id="formSignin" (ngSubmit)="TryRegisterUser()">\r
    <!-- NOME -->\r
    <label for="name">Nome Completo <span style="color: red">*</span></label>\r
    <small id="errorName" class="inputError"></small>\r
\r
    <input\r
      type="text"\r
      name="name"\r
      id="name"\r
      maxlength="50"\r
      required\r
      [(ngModel)]="nameField"\r
      (blur)="UpdateFirstInput('name')"\r
      (input)="NameIsValid(nameField); checkForm()"\r
    />\r
\r
    <!-- CPF -->\r
    <label for="cpf">CPF <span style="color: red">*</span></label>\r
    <small id="errorCPF" class="inputError"></small>\r
\r
    <input\r
      type="text"\r
      name="cpf"\r
      id="cpf"\r
      maxlength="14"\r
      required\r
      [(ngModel)]="cpfField"\r
      (blur)="UpdateFirstInput('cpf')"\r
      (input)="$event.target.value = formatCPF(cpfField); CPFIsValid(cpfField); checkForm()"\r
    />\r
\r
    <!-- EMAIL -->\r
    <label for="email">E-mail <span style="color: red">*</span></label>\r
    <small id="errorEmail" class="inputError"></small>\r
\r
    <input\r
      type="email"\r
      name="email"\r
      id="email"\r
