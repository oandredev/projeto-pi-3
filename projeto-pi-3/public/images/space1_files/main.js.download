              <button class="qtd-btn minus" (click)="decreaseItem(item)">-</button>\r
              <span>{{ item.quantity }}</span>\r
\r
              <button class="qtd-btn plus" (click)="increaseItem(item)">+</button>\r
            </div>\r
          </td>\r
\r
          <!-- VALUES -->\r
          <td>R$ {{ getUnitValue(item) | number: '1.2-2' }}</td>\r
          <td>R$ {{ getSubtotal(item) | number: '1.2-2' }}</td>\r
\r
          <!-- DELETE ITEM -->\r
          <td>\r
            <button class="delete-btn" (click)="removeItem(item)">Excluir</button>\r
          </td>\r
        </tr>\r
      </tbody>\r
    </table>\r
\r
    <div id="cartTotalBox" *ngIf="cart?.valueTotal">\r
      <h2>Total:</h2>\r
      <p>R$ {{ cart?.valueTotal | number: '1.2-2' }}</p>\r
    </div>\r
\r
    <ng-template #emptyCart>\r
      <p class="empty">Seu carrinho est\xE1 vazio.</p>\r
    </ng-template>\r
  </div>\r
\r
  <aside *ngIf="cart && cart.items?.length" class="payment-area">\r
    <h2>Pagamento</h2>\r
\r
    <div class="payment-options">\r
      <label>\r
        <input type="radio" name="payment" [(ngModel)]="paymentMethod" value="pix" />\r
        PIX\r
      </label>\r
\r
      <label>\r
        <input type="radio" name="payment" [(ngModel)]="paymentMethod" value="debito" />\r
        D\xE9bito\r
      </label>\r
\r
      <label>\r
        <input type="radio" name="payment" [(ngModel)]="paymentMethod" value="credito" />\r
        Cr\xE9dito\r
      </label>\r
      <label>\r
        <input type="radio" name="payment" [(ngModel)]="paymentMethod" value="boleto" />\r
        Boleto\r
      </label>\r
    </div>\r
\r
    <div *ngIf="paymentMethod === 'credito'" class="installments-box">\r
      <label>Parcelas: </label>\r
      <select [(ngModel)]="installments">\r
        <option [value]="0" disabled selected>Selecione a quantidade de parcelas</option>\r
\r
        <option *ngFor="let p of [1, 2, 3, 4, 5, 6]" [value]="p">\r
          {{ p }}x de {{ +(cart.valueTotal ?? 0) / p | number: '1.2-2' }}\r
        </option>\r
      </select>\r
    </div>\r
\r
    <button class="finish-btn" (click)="finishOrder()" [disabled]="!isOrderValid()">\r
      Finalizar Compra\r
    </button>\r
  </aside>\r
</div>\r
`, styles: ['/* src/app/pages/cart/cart.css */\n#cartPage {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-start;\n  gap: 2rem;\n  max-width: 1300px;\n  margin: 2rem auto;\n  padding: 0 1rem;\n}\n.cart-area {\n  flex: 1;\n  min-width: 0;\n  width: 100%;\n}\n.cart-area h1 {\n  margin-bottom: 1rem;\n  font-size: 1.8rem;\n  text-align: center;\n}\n.cart-table {\n  width: 100%;\n  border-collapse: collapse;\n  background: #fff;\n  border-radius: 14px;\n  overflow: hidden;\n  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);\n  table-layout: fixed;\n}\n.cart-table thead {\n  background: linear-gradient(#009246, #004f26);\n  color: rgb(255, 255, 255);\n  font-weight: normal;\n}\n.cart-table th {\n  padding: 1rem;\n  background-color: none;\n  text-align: center;\n}\n.cart-table thead th:nth-child(1) {\n  width: auto;\n}\n.cart-table thead th:nth-child(2) {\n  width: 120px;\n}\n.cart-table thead th:nth-child(3) {\n  width: 120px;\n}\n.cart-table thead th:nth-child(4) {\n  width: 120px;\n}\n.cart-table thead th:nth-child(5) {\n  width: 80px;\n}\n.cart-table td {\n  padding: 0.5rem 0.75rem;\n  border-top: 1px solid #eee;\n  vertical-align: middle;\n  text-align: center;\n}\n.cart-table td.item-cell {\n  text-align: left;\n}\n.cart-table td p {\n  color: #666;\n  font-size: 0.9rem;\n  margin-top: 0.3rem;\n}\n.cart-table td:nth-child(2) {\n  text-align: center;\n}\n.qtd-area-inner {\n  display: flex;\n  justify-content: space-between;\n  padding: 0 1rem;\n}\n.qtd-btn {\n  padding: 0.4rem 0.8rem;\n  border: none;\n  border-radius: 6px;\n  font-weight: bolder;\n  cursor: pointer;\n  color: #fff;\n  transition: 0.25s;\n  display: inline-block;\n  text-align: center;\n  transform: scale(0.98);\n  transition: 0.3s ease;\n}\n.qtd-btn.plus {\n  background: #004f26;\n}\n.qtd-btn.plus:hover {\n  background: #007539;\n}\n.qtd-btn.minus {\n  background: #ce2b37;\n}\n.qtd-btn.minus:hover {\n  background: #e04652;\n}\n.qtd-btn:hover {\n  transform: scale(1.05);\n}\n.qtd-btn:active {\